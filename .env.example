# Ejemplo de variables de entorno
# Copiar a .env.local y llenar con valores reales

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (opcional)
NEXT_PUBLIC_GA_ID=

# CDN (si se usa un CDN externo para assets)
NEXT_PUBLIC_CDN_URL=https://cdn.example.com/assets

# API Base URL (para endpoints internos)
NEXT_PUBLIC_API_URL=/api

# Environment
NODE_ENV=development
